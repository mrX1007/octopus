# Octopus Application Configuration Example
OCTOPUS_C2_SOCKET=/run/octopus/octopus-c2.sock
OCTOPUS_C2_STATE_DIR=/var/lib/octopus
OCTOPUS_C2_CONTROL_PUBKEY=/etc/octopus/control-server-ed25519.pub

# Database Configuration
OCTOPUS_DB_HOST=127.0.0.1
OCTOPUS_DB_NAME=octopus
OCTOPUS_DB_USER=octopus
OCTOPUS_DB_PASS=octopus_password
