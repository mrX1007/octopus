[Unit]
Description=OCTOPUS C2 daemon
Requires=octopus-c2.socket
After=octopus-c2.socket network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
User=octopus-c2
Group=octopus-c2
SupplementaryGroups=octopus-c2-clients
StateDirectory=octopus
RuntimeDirectory=octopus
ConfigurationDirectory=octopus
WorkingDirectory=/var/lib/octopus
Environment=OCTOPUS_DATA_DIR=/var/lib/octopus
Environment=OCTOPUS_C2_SOCKET=/run/octopus/octopus-c2.sock
EnvironmentFile=-/etc/octopus/octopus-c2.env
ExecStart=/usr/bin/env octopus-c2
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
